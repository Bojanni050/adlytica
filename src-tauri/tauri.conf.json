{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Adlytica",
  "version": "0.1.0",
  "identifier": "nl.whitevision.adlytica",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Adlytica — SEO & Ads Command Center",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "msi", "app"],
    "icon": ["icons/icon.png"]
  }
}
